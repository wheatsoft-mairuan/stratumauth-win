<Window x:Class="Stratum.Win.Views.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备份" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Icon="pack://application:,,,/Assets/stratum.ico"
        Background="{StaticResource WindowBackground}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextPrimary}"
        ShowInTaskbar="False">
    <StackPanel Margin="22,20">
        <TextBlock Text="导出备份" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Text="加密后的 .stratum 备份可以在 Stratum（Android 与 Windows）之间互相恢复。"
                   FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="格式" VerticalAlignment="Center" Margin="0,0,0,10"
                       Foreground="{StaticResource TextSecondary}" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="FormatBox" Margin="0,0,0,10"
                      SelectionChanged="FormatBox_SelectionChanged">
                <ComboBoxItem Content="Stratum 备份 (.stratum)" />
                <ComboBoxItem Content="网页备份 (.html)" />
                <ComboBoxItem Content="URI 列表 (.txt)" />
            </ComboBox>

            <TextBlock Grid.Row="1" Text="保存到" VerticalAlignment="Center" Margin="0,0,0,10"
                       Foreground="{StaticResource TextSecondary}" />
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" />
                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                        Click="Browse_Click" />
            </Grid>

            <TextBlock Grid.Row="2" x:Name="PasswordLabel" Text="密码" VerticalAlignment="Center"
                       Margin="0,0,0,10" Foreground="{StaticResource TextSecondary}" />
            <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="PasswordInput" Margin="0,0,0,10"
                         ToolTip="留空则导出未加密的备份（不推荐）" />
        </Grid>

        <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                   Foreground="{StaticResource TextSecondary}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="关闭" Style="{StaticResource BaseButton}" Margin="0,0,8,0" IsCancel="True"
                    Click="Close_Click" />
            <Button Content="导出" Style="{StaticResource AccentButton}" Click="Export_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
