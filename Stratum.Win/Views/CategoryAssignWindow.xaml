<Window x:Class="Stratum.Win.Views.CategoryAssignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择分类" Height="440" Width="440"
        Icon="pack://application:,,,/Assets/stratum.ico"
        Background="{StaticResource WindowBackground}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="所属分类" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="一个验证器可以同时属于多个分类。" FontSize="12"
                   Foreground="{StaticResource TextMuted}" Margin="0,6,0,12" />

        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}"
                BorderThickness="1" CornerRadius="10" Padding="6">
            <ListBox x:Name="CategoryList" Style="{StaticResource FlatListBox}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="4">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="6,5"
                                  Content="{Binding Name}" Foreground="{StaticResource TextPrimary}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock x:Name="EmptyText" Grid.Row="2" Text="还没有分类。先在左侧边栏「新建分类」。"
                   FontSize="12" Foreground="{StaticResource TextMuted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource BaseButton}" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="保存" Style="{StaticResource AccentButton}" Padding="18,7" IsDefault="True"
                    Click="Save_Click" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="{StaticResource Danger}" FontSize="12"
                   VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="Wrap"
                   MaxWidth="240" />
    </Grid>
</Window>
