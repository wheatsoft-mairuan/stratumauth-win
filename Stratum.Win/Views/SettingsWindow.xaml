<Window x:Class="Stratum.Win.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="440" Width="480"
        Icon="pack://application:,,,/Assets/stratum.ico"
        Background="{StaticResource WindowBackground}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="验证码分组" FontSize="13" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" />
                <ComboBox x:Name="GroupSizeBox" Grid.Column="1" HorizontalAlignment="Left" Width="140">
                    <ComboBoxItem Content="不分组" />
                    <ComboBoxItem Content="每 3 位" />
                    <ComboBoxItem Content="每 4 位" />
                </ComboBox>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="排序方式" FontSize="13" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" />
                <ComboBox x:Name="SortBox" Grid.Column="1" HorizontalAlignment="Left" Width="180">
                    <ComboBoxItem Content="自定义（手动排序）" />
                    <ComboBoxItem Content="按字母升序" />
                    <ComboBoxItem Content="按字母降序" />
                    <ComboBoxItem Content="按复制次数：多到少" />
                    <ComboBoxItem Content="按复制次数：少到多" />
                </ComboBox>
            </Grid>

            <CheckBox x:Name="ShowUsernamesBox" Content="在列表中显示用户名" FontSize="13"
                      Margin="0,2,0,14" />

            <CheckBox x:Name="ConfirmDeleteBox" Content="删除验证器前先确认" FontSize="13" IsChecked="True" />

            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}"
                    BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="数据位置" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="DataPathText" FontSize="11" Foreground="{StaticResource TextMuted}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock x:Name="SecretText" FontSize="11" Foreground="{StaticResource TextMuted}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource BaseButton}" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="保存" Style="{StaticResource AccentButton}" Padding="18,7" IsDefault="True"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
