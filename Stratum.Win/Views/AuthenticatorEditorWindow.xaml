<Window x:Class="Stratum.Win.Views.AuthenticatorEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加验证器" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource WindowBackground}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextPrimary}"
        ShowInTaskbar="False">
    <StackPanel Margin="22,20">
        <TextBlock Text="手动添加验证器" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Text="输入密钥（Base32）；Steam/Yandex 也可用对应类型。" FontSize="12"
                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="类型" VerticalAlignment="Center" Margin="0,0,0,10"
                       Foreground="{StaticResource TextSecondary}" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TypeBox" Margin="0,0,0,10" Height="34"
                      SelectionChanged="TypeBox_SelectionChanged">
                <ComboBoxItem Content="基于时间 (TOTP)" />
                <ComboBoxItem Content="基于计数器 (HOTP)" />
                <ComboBoxItem Content="Steam" />
                <ComboBoxItem Content="Yandex" />
                <ComboBoxItem Content="mOTP" />
            </ComboBox>

            <TextBlock Grid.Row="1" Text="发行方" VerticalAlignment="Center" Margin="0,0,0,10"
                       Foreground="{StaticResource TextSecondary}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="IssuerBox" Margin="0,0,0,10" MaxLength="32" />

            <TextBlock Grid.Row="2" Text="用户名" VerticalAlignment="Center" Margin="0,0,0,10"
                       Foreground="{StaticResource TextSecondary}" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="UsernameBox" Margin="0,0,0,10" MaxLength="40" />

            <TextBlock Grid.Row="3" Text="密钥" VerticalAlignment="Center" Margin="0,0,0,10"
                       Foreground="{StaticResource TextSecondary}" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="SecretBox" Margin="0,0,0,10"
                     FontFamily="{StaticResource MonoFont}" />

            <TextBlock Grid.Row="4" Text="算法" VerticalAlignment="Center" Margin="0,0,0,10"
                       Foreground="{StaticResource TextSecondary}" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                <ComboBox x:Name="AlgorithmBox" Width="130" Height="34">
                    <ComboBoxItem Content="SHA1" />
                    <ComboBoxItem Content="SHA256" />
                    <ComboBoxItem Content="SHA512" />
                </ComboBox>
                <TextBlock Text="位数" VerticalAlignment="Center" Margin="16,0,8,0"
                           Foreground="{StaticResource TextSecondary}" />
                <TextBox x:Name="DigitsBox" Width="60" Text="6" />
                <TextBlock Text="周期" VerticalAlignment="Center" Margin="16,0,8,0"
                           Foreground="{StaticResource TextSecondary}" />
                <TextBox x:Name="PeriodBox" Width="60" Text="30" />
            </StackPanel>

            <TextBlock Grid.Row="5" Text="计数器 / PIN" VerticalAlignment="Center" Margin="0,0,0,10"
                       Foreground="{StaticResource TextSecondary}" />
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox x:Name="CounterBox" Width="110" Text="0" ToolTip="HOTP 计数器" />
                <TextBox x:Name="PinBox" Width="150" Margin="12,0,0,0" ToolTip="Yandex / mOTP 的 PIN"
                         FontFamily="{StaticResource MonoFont}" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource BaseButton}" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="保存" Style="{StaticResource AccentButton}" Click="Save_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
