<Window x:Class="Stratum.Win.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Stratum.Win.ViewModels"
        Title="Stratum" Height="720" Width="1040" MinHeight="520" MinWidth="760"
        Background="{StaticResource WindowBackground}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource Stroke}"
                BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource Accent}"
                            VerticalAlignment="Center">
                        <TextBlock Text="S" Foreground="White" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Stratum" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="双因素验证器" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" Margin="24,0" MaxWidth="420" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" ToolTip="搜索发行方或用户名"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                    <TextBlock Text="搜索发行方或用户名" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="13" Foreground="{StaticResource TextMuted}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="＋ 添加" Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                            Click="AddManual_Click" />
                    <Button Content="URI" Style="{StaticResource BaseButton}" Margin="0,0,8,0"
                            ToolTip="从 otpauth:// 链接添加" Click="AddUri_Click" />
                    <Button Content="图片" Style="{StaticResource BaseButton}" Margin="0,0,16,0"
                            ToolTip="从二维码图片导入" Click="AddImage_Click" />
                    <Button Content="导入" Style="{StaticResource BaseButton}" Margin="0,0,8,0"
                            ToolTip="从其他验证器应用或备份导入" Click="Import_Click" />
                    <Button Content="备份" Style="{StaticResource BaseButton}"
                            ToolTip="导出加密备份" Click="Backup_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- List -->
        <Grid Grid.Row="1">
            <ListBox x:Name="List" Style="{StaticResource FlatListBox}" Margin="16,14,16,6"
                     ItemsSource="{Binding Items}"
                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AuthenticatorItemViewModel}">
                        <Border Style="{StaticResource Card}" MouseLeftButtonUp="Card_Click" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="40" Height="40" CornerRadius="10" Background="#22262F"
                                        VerticalAlignment="Center">
                                    <Image Source="{Binding IconImage}" Width="28" Height="28"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Issuer}" FontSize="15" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Username}" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasUsername, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding CodeDisplay}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimary}" />

                                <Grid Grid.Column="3" Width="30" Height="30" Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding IsTimeBased, Converter={StaticResource BoolToVisibility}}">
                                    <Ellipse Stroke="{StaticResource TrackBrush}" StrokeThickness="3" />
                                    <Path Data="{Binding Progress, Converter={StaticResource ArcGeometry}, ConverterParameter=30}"
                                          Stroke="{StaticResource Accent}" StrokeThickness="3" Stretch="None" />
                                    <TextBlock Text="{Binding SecondsRemaining}" FontSize="10"
                                               Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Content="⟳" ToolTip="刷新计数器"
                                            Click="RefreshCounter_Click"
                                            Visibility="{Binding IsCounter, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource IconButton}" Content="⧉" ToolTip="复制验证码"
                                            Click="Copy_Click" />
                                    <Button Style="{StaticResource IconButton}" Content="🗑" ToolTip="删除"
                                            Foreground="{StaticResource TextSecondary}"
                                            Click="Delete_Click" Margin="2,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="尚无验证器" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                <TextBlock Text="点击右上角「添加」手动录入，或用 URI / 二维码图片导入" FontSize="13"
                           Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="12"
                       Margin="24,0,24,8" VerticalAlignment="Bottom" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource Stroke}"
                BorderThickness="0,1,0,0" Padding="20,7">
            <Grid>
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                <TextBlock Text="双击列表项或按 Ctrl+C 复制当前验证码" FontSize="11"
                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
