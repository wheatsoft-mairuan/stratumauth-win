<Window x:Class="Stratum.Win.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource WindowBackground}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextPrimary}"
        ShowInTaskbar="False">
    <StackPanel Margin="22,20">
        <TextBlock Text="导入验证器" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Text="支持 Stratum 备份，以及 Aegis、Bitwarden、2FAS、KeePass、Google Authenticator 等常见应用的导出文件。"
                   FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="来源" VerticalAlignment="Center" Margin="0,0,0,10"
                       Foreground="{StaticResource TextSecondary}" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="SourceBox" Margin="0,0,0,10" />

            <TextBlock Grid.Row="1" Text="文件" VerticalAlignment="Center" Margin="0,0,0,10"
                       Foreground="{StaticResource TextSecondary}" />
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" IsReadOnly="True" />
                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                        Click="Browse_Click" />
            </Grid>

            <TextBlock Grid.Row="2" Text="密码" VerticalAlignment="Center" Margin="0,0,0,10"
                       Foreground="{StaticResource TextSecondary}" />
            <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="PasswordInput" Margin="0,0,0,10"
                         ToolTip="仅加密备份需要" />
        </Grid>

        <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                   Foreground="{StaticResource TextSecondary}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="关闭" Style="{StaticResource BaseButton}" Margin="0,0,8,0" IsCancel="True"
                    Click="Close_Click" />
            <Button Content="导入" Style="{StaticResource AccentButton}" Click="Import_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
